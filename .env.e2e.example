APP_NAME=Gilatennis
APP_ENV=local
APP_KEY=base64:SEfFuEXOYXwMDCZW1AEZ0ZIBR4mmmy/bnge0EoY7ebk=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dedicated, disposable database seeded by `php artisan db:seed --class=E2ESeeder`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gilatennis_e2e
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Array cache: per-request, so the login rate limiter never throttles the
# suite's repeated admin logins (the specs sign in through the real form).
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SCOUT_DRIVER=collection

# Credentials the Playwright admin helper signs in with (mirror e2e/helpers/accounts.ts).
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=password
